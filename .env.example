# Baza danych
POSTGRES_DB=pogwizdek
POSTGRES_USER=pogwizdek
POSTGRES_PASSWORD=zmien-mnie

# JWT (sekret min. 32 znaki)
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow-min-32
JWT_EXPIRES_IN=24h

# Konto administratora tworzone przy starcie (puste = brak konta)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pogwizdek.local
ADMIN_PASSWORD=zmien-mnie

# Dane demonstracyjne, używane gdy synchronizacja jest wyłączona
LOAD_DEMO_DATA=true

# Synchronizacja z football-data.org (token: https://www.football-data.org/client/register)
FOOTBALL_DATA_TOKEN=
# Kody rozgrywek: CL – Liga Mistrzów, PL – Premier League
FOOTBALL_DATA_COMPETITIONS=CL,PL
FOOTBALL_DATA_INTERVAL_MINUTES=10
