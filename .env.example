# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIE trafia do repozytorium (.gitignore).

# Baza danych
POSTGRES_DB=pogwizdek
POSTGRES_USER=pogwizdek
POSTGRES_PASSWORD=zmien-mnie

# JWT – minimum 32 znaki dowolnego losowego tekstu
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow-min-32
JWT_EXPIRES_IN=24h

# Konto administratora zakładane przy pierwszym starcie (zostaw puste, żeby pominąć)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pogwizdek.local
ADMIN_PASSWORD=zmien-mnie

# Przykładowe rozgrywki, drużyny i mecze – tylko gdy synchronizacja jest wyłączona (brak tokenu)
LOAD_DEMO_DATA=true

# Synchronizacja z football-data.org – darmowy token: https://www.football-data.org/client/register
# Bez tokenu aplikacja działa na danych demo.
FOOTBALL_DATA_TOKEN=
# kody rozgrywek oddzielone przecinkami (CL = Liga Mistrzów, PL = Premier League)
FOOTBALL_DATA_COMPETITIONS=CL,PL
FOOTBALL_DATA_INTERVAL_MINUTES=10
