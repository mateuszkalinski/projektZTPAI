# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIE trafia do repozytorium (.gitignore).

# Baza danych
POSTGRES_DB=pogwizdek
POSTGRES_USER=pogwizdek
POSTGRES_PASSWORD=zmien-mnie

# JWT – minimum 32 znaki dowolnego losowego tekstu
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow-min-32
JWT_EXPIRES_IN=24h

# Konto administratora zakładane przy pierwszym starcie (zostaw puste, żeby pominąć)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pogwizdek.local
ADMIN_PASSWORD=zmien-mnie

# Przykładowe rozgrywki, drużyny i mecze przy pierwszym starcie
LOAD_DEMO_DATA=true

# Na później: token do football-data.org (synchronizacja meczów i wyników)
FOOTBALL_DATA_TOKEN=
