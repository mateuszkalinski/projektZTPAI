{
  "name": "pogwizdek-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pogwizdek – REST API do typowania meczów ze znajomymi",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
